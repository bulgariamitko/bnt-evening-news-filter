{
  "manifest_version": 3,
  "name": "BNT Evening News Filter",
  "version": "1.2.0",
  "description": "On the BNT1 YouTube channel, show only the 20:00 evening news (По света и у нас) and hide everything else.",
  "permissions": ["storage"],
  "action": {
    "default_title": "BNT Evening News Filter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
